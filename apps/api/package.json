{
  "name": "@nexgen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint . --ext .ts --report-unused-disable-directives --ignore-pattern 'node_modules/*' --ignore-pattern 'dist/*' --config eslint.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "prisma db seed --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^3.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/throttler": "^3.0.0",
    "@nexgen/shared": "workspace:*",
    "@prisma/client": "^5.6.3",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.8.0",
    "prisma": "^5.6.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  }
}
