# Container-specific environment values for Docker Compose
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:postgres@db:5432/nexgen_esport
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexgen_esport
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
STORAGE_DRIVER=local
STORAGE_MAX_SIZE_BYTES=10485760
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4
THROTTLE_TTL=60
THROTTLE_LIMIT=10
NEXT_PUBLIC_API_BASE_URL=http://api:3000/api/v1
