{
  "name": "nexgen-esport-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm -r lint && pnpm -r test && pnpm -r build",
    "ci": "pnpm install && pnpm -r lint && pnpm -r test && pnpm -C apps/api prisma:validate && pnpm -r build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.8.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  }
}
